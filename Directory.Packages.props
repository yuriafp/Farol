<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="MCP">
    <PackageVersion Include="ModelContextProtocol" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup Label="Roslyn">
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.VisualBasic.Workspaces" Version="5.9.0" />
    <!-- Built-in code fixes and refactorings (add using, generate member, ...) for dotnet_code_actions. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Features" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.VisualBasic.Features" Version="5.9.0" />
  </ItemGroup>

  <ItemGroup Label="MSBuild">
    <!-- Reads binary logs: build errors and warnings with their projects and target frameworks. -->
    <PackageVersion Include="MSBuild.StructuredLogger" Version="2.3.246" />
  </ItemGroup>

  <ItemGroup Label="NuGet">
    <!-- dotnet_packages and dotnet_package_api: feeds, credential providers, vulnerability and deprecation data, restore's assets files. -->
    <PackageVersion Include="NuGet.Credentials" Version="7.9.0" />
    <PackageVersion Include="NuGet.ProjectModel" Version="7.9.0" />
  </ItemGroup>

  <ItemGroup Label="Decompilation">
    <!-- Source of external (metadata) symbols for dotnet_symbol: the ILSpy engine, MIT. -->
    <PackageVersion Include="ICSharpCode.Decompiler" Version="11.1.0.9782" />
  </ItemGroup>

  <ItemGroup Label="Microsoft.Extensions">
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.1" />
    <!-- Spike A only (binlog replay); promote to src once a loader uses it. -->
    <PackageVersion Include="Basic.CompilerLog.Util" Version="0.9.63" />
    <PackageVersion Include="Microsoft.CodeAnalysis" Version="5.9.0" />
  </ItemGroup>
</Project>
