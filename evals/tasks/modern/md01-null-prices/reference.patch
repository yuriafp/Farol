index b970119..6355ce5 100644
--- a/src/Modern.Core/Pricing/PriceCalculator.cs
+++ b/src/Modern.Core/Pricing/PriceCalculator.cs
@@ -14,6 +14,11 @@ public sealed class PriceCalculator(IClock clock)
 {
     public decimal Total(IEnumerable<decimal> prices, decimal weekendDiscount)
     {
+        if (prices is null)
+        {
+            throw new ArgumentNullException(nameof(prices));
+        }
+
         var subtotal = prices.Sum();
         var discount = IsWeekend(clock.UtcNow) ? weekendDiscount : 0m;
         return Math.Round(subtotal * (1 - discount), 2);
