{
  "job": "migrate-legacy",
  "repo": "dnn-platform",
  "maxTurns": 50,
  "timeoutMinutes": 25,
  "checks": [
    { "type": "file", "name": "targets both", "path": "DNN Platform/DotNetNuke.Abstractions/DotNetNuke.Abstractions.csproj", "patterns": [ "<TargetFrameworks>[^<]*netstandard2\\.0", "<TargetFrameworks>[^<]*net10\\.0" ] },
    { "type": "command", "name": "builds for both target frameworks", "run": "dotnet build \"DNN Platform/DotNetNuke.Abstractions/DotNetNuke.Abstractions.csproj\" -c Debug -v:q -nologo", "timeoutMinutes": 10 }
  ]
}
