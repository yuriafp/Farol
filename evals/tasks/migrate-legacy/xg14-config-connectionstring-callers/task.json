        "(?s)```callers(?:(?!```).)*?(?<![\\w.])Utilities[/\\\\]Config\\.cs",
        "(?s)```callers(?:(?!```).)*?(?<![\\w.])Services[/\\\\]SqlConsoleController\\.cs"
      ]
    },
    {
      "type": "answer",
      "name": "no file that only looks like one",
      "match": "none",
      "patterns": [
        "(?s)```callers(?:(?!```).)*?(?<![\\w.])Common[/\\\\]Globals\\.cs",
        "(?s)```callers(?:(?!```).)*?(?<![\\w.])Data[/\\\\]DataProvider\\.cs",
        "(?s)```callers(?:(?!```).)*?(?<![\\w.])Internals[/\\\\]InstallControllerImpl\\.cs",
        "(?s)```callers(?:(?!```).)*?(?<![\\w.])Steps[/\\\\]SynchConnectionStringStep\\.cs"
      ]
    },
    {
      "type": "changed",
      "name": "changes nothing",
      "only": []
