<Window x:Class="Legacy.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Legacy.Wpf"
        Title="Legacy Orders" Height="150" Width="300">
    <Window.Resources>
        <local:PriceConverter x:Key="Price" />
    </Window.Resources>
    <StackPanel Margin="12">
        <Button Content="Calculate" Click="OnCalculateClick" />
        <TextBlock x:Name="TotalText" Margin="0,12,0,0" />
    </StackPanel>
</Window>
