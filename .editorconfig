root = true

[*]
charset = utf-8
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,vb}]
indent_size = 4

[*.{csproj,vbproj,props,targets,slnx,xml,json,yml,yaml}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_prefer_primary_constructors = true:suggestion
dotnet_style_prefer_collection_expression = true:suggestion

# Hosts have no SynchronizationContext; ConfigureAwait noise buys nothing here.
dotnet_diagnostic.CA2007.severity = none
# Adopt LoggerMessage source generation when logging volume justifies it.
dotnet_diagnostic.CA1848.severity = suggestion

[tests/**.cs]
# xUnit test names use underscores and test types must be public.
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1515.severity = none
