<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <IsPackable>false</IsPackable>
    <!-- Tool output is English everywhere: without satellite assemblies, Roslyn's diagnostics and code action titles
         stay in English whatever the machine's language. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup Label="Package metadata">
    <!-- One version for the package, the server it reports and the Claude Code plugin; the release checklist
         (docs/release.md) lists every file that repeats it, and a test keeps them equal. -->
    <Version>0.1.0-alpha.1</Version>
    <Authors>Farol contributors</Authors>
    <Copyright>Copyright (c) 2026 Farol contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>mcp;model-context-protocol;dotnet;roslyn;msbuild;legacy;dotnet-framework;ai-agents</PackageTags>
  </PropertyGroup>
</Project>
